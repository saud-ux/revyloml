# Copy to .env.local for local development. With none of these set the site
# still runs: it serves the JSON seed read-only and the admin refuses to sign in.

# Postgres. Works with Render Postgres and with Supabase — same variable.
# Leave unset to run off data/songs.json instead.
DATABASE_URL=postgresql://user:password@host:5432/revyloml

# Set to "off" for a local Postgres with no TLS. Omit in production.
DATABASE_SSL=off

# Signs the session cookie. Any long random string; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The admin password. Set ONE of these.
# Simplest — type the password itself; it is hashed at boot:
ADMIN_PASSWORD=
# Or store a scrypt hash instead (wins if both are set):
#   npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=

# Where uploaded audio and cover art go. Pick ONE backend.
#
# A) Supabase Storage — required on a free Render instance, which has no disk.
#    Create a PUBLIC bucket named "media" first. The service_role key bypasses
#    row level security, so keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
#
# B) Local disk — used when the SUPABASE_* variables above are empty. On Render
#    this must be a persistent disk's mount path, or uploads vanish on deploy.
UPLOAD_DIR=./.uploads
